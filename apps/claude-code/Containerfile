ARG UBI_IMAGE=registry.access.redhat.com/ubi10/ubi:latest@sha256:454c3b22fd9dc97859df5a6bce662da1af5e3cf18313ef034190de3759392add
ARG UBI_IMAGE_MICRO=registry.access.redhat.com/ubi10/ubi-micro:latest@sha256:37fadb004c6bea628fcdd81376c8fb77bd8d9fd432d90503af4d9e76b1ff7191

FROM ${UBI_IMAGE_MICRO} AS target

# ---------------------------------------------------------------------------
# Build stage — install everything into ubi-micro rootfs
# ---------------------------------------------------------------------------
FROM ${UBI_IMAGE} AS build

ARG DNF_INSTALL_ROOT="/mnt/rootfs"
ARG DNF_OPTS="--setopt install_weak_deps=false --nodocs"
ARG DNF_OPTS_ROOT="-y --installroot ${DNF_INSTALL_ROOT}"

RUN mkdir -p ${DNF_INSTALL_ROOT}
COPY --from=target / ${DNF_INSTALL_ROOT}/

# Build dependencies (not installed into rootfs)
RUN dnf install -y unzip xz tar gzip

# EPEL 10 for additional packages
RUN dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm || true

# ---------------------------------------------------------------------------
# System packages into rootfs
# ---------------------------------------------------------------------------
RUN dnf ${DNF_OPTS_ROOT} ${DNF_OPTS} --skip-broken install \
    bash \
    coreutils \
    curl \
    tar \
    gzip \
    xz \
    unzip \
    findutils \
    git \
    jq \
    make \
    tree \
    openssh-clients \
    iputils \
    bind-utils \
    file \
    rsync \
    nmap \
    nmap-ncat \
    socat \
    iproute \
    python3 \
    python3-pip \
    python3-netaddr \
    which \
    procps-ng \
    && dnf ${DNF_OPTS_ROOT} clean all \
    && rm -rf ${DNF_INSTALL_ROOT}/var/cache/* ${DNF_INSTALL_ROOT}/var/log/dnf* ${DNF_INSTALL_ROOT}/var/log/yum.*

# bubblewrap — required by Claude Code sandbox. Not in UBI10 repos, so install
# from CentOS 10-stream BaseOS as a one-off (--repofrompath avoids persisting the repo).
RUN dnf ${DNF_OPTS_ROOT} ${DNF_OPTS} --nogpgcheck \
    --repofrompath=centos-baseos,https://mirror.stream.centos.org/10-stream/BaseOS/$(uname -m)/os/ \
    --repo=centos-baseos \
    install bubblewrap \
    && dnf ${DNF_OPTS_ROOT} clean all

RUN mkdir -p ${DNF_INSTALL_ROOT}/usr/local/bin

# ---------------------------------------------------------------------------
# CLI tools — pinned versions managed by Renovate
# ---------------------------------------------------------------------------

# renovate: datasource=github-releases depName=kubernetes/kubernetes
ARG KUBECTL_VERSION="v1.37.1"
# renovate: datasource=github-releases depName=helm/helm
ARG HELM_VERSION="v4.3.0"
# renovate: datasource=github-releases depName=cli/cli
ARG GH_VERSION="v2.101.0"
# renovate: datasource=github-releases depName=argoproj/argo-cd
ARG ARGOCD_VERSION="v3.5.3"
# renovate: datasource=github-releases depName=kubernetes-sigs/kustomize extractVersion=^kustomize/(?<version>.*)$
ARG KUSTOMIZE_VERSION="v5.8.1"
# renovate: datasource=github-releases depName=kubevirt/kubevirt
ARG VIRTCTL_VERSION="v1.9.0"
# renovate: datasource=github-releases depName=yannh/kubeconform
ARG KUBECONFORM_VERSION="v0.8.0"
# renovate: datasource=github-releases depName=tektoncd/cli
ARG TKN_VERSION="v0.46.1"
# renovate: datasource=github-releases depName=rclone/rclone
ARG RCLONE_VERSION="v1.75.1"
# renovate: datasource=github-releases depName=containers/kubernetes-mcp-server
ARG K8S_MCP_VERSION="v0.0.67"
# renovate: datasource=custom.openshift-mirror depName=oc
ARG OC_VERSION="4.21.34"
# renovate: datasource=github-releases depName=minio/mc versioning=regex:^RELEASE\.(?<major>\d{4})-(?<minor>\d{2})-(?<patch>\d{2})T\d{2}-\d{2}-\d{2}Z$
ARG MC_VERSION="RELEASE.2025-08-13T08-35-41Z"

# ---------------------------------------------------------------------------
# Binary downloads into rootfs
# ---------------------------------------------------------------------------
RUN set -eux; \
    UARCH=$(uname -m); \
    case "$UARCH" in x86_64) ARCH=amd64;; aarch64) ARCH=arm64;; *) ARCH=$UARCH;; esac; \
    ARCH_X86=$UARCH; \
    ARCH_GNU=$UARCH; \
    BIN=${DNF_INSTALL_ROOT}/usr/local/bin; \
    # kubectl
    curl -sSL -o ${BIN}/kubectl \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" && \
    chmod +x ${BIN}/kubectl; \
    # helm
    curl -sSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" \
      | tar -xz --strip-components=1 -C ${BIN} "linux-${ARCH}/helm"; \
    # gh CLI
    GH_VERSION_BARE="${GH_VERSION#v}"; \
    curl -sSL "https://github.com/cli/cli/releases/download/${GH_VERSION}/gh_${GH_VERSION_BARE}_linux_${ARCH}.tar.gz" \
      | tar -xz --strip-components=2 -C ${BIN} "gh_${GH_VERSION_BARE}_linux_${ARCH}/bin/gh"; \
    # ArgoCD
    curl -sSL -o ${BIN}/argocd \
      "https://github.com/argoproj/argo-cd/releases/download/${ARGOCD_VERSION}/argocd-linux-${ARCH}" && \
    chmod +x ${BIN}/argocd; \
    # kustomize
    curl -sSL "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/kustomize_${KUSTOMIZE_VERSION}_linux_${ARCH}.tar.gz" \
      | tar -xz -C ${BIN} kustomize; \
    # OpenShift CLI (oc)
    curl -sSL "https://mirror.openshift.com/pub/openshift-v4/${ARCH_X86}/clients/ocp/${OC_VERSION}/openshift-client-linux.tar.gz" \
      | tar -xz -C ${BIN} oc; \
    # virtctl
    curl -sSL -o ${BIN}/virtctl \
      "https://github.com/kubevirt/kubevirt/releases/download/${VIRTCTL_VERSION}/virtctl-${VIRTCTL_VERSION}-linux-${ARCH}" && \
    chmod +x ${BIN}/virtctl; \
    # kubeconform
    curl -sSL "https://github.com/yannh/kubeconform/releases/download/${KUBECONFORM_VERSION}/kubeconform-linux-${ARCH}.tar.gz" \
      | tar -xz -C ${BIN} kubeconform; \
    # tkn (Tekton CLI)
    TKN_VERSION_BARE="${TKN_VERSION#v}"; \
    curl -sSL "https://github.com/tektoncd/cli/releases/download/${TKN_VERSION}/tkn_${TKN_VERSION_BARE}_Linux_${ARCH_GNU}.tar.gz" \
      | tar -xz -C ${BIN} tkn; \
    # mc (MinIO client — versioned release with upstream checksum)
    MC_ASSET="mc.linux-${ARCH}.${MC_VERSION}"; \
    MC_BASE="https://github.com/minio/mc/releases/download/${MC_VERSION}"; \
    curl -fsSL -o /tmp/${MC_ASSET} "${MC_BASE}/${MC_ASSET}" && \
    curl -fsSL "${MC_BASE}/${MC_ASSET}.sha256sum" -o /tmp/mc.sha256sum && \
    MC_SHA=$(cut -d' ' -f1 /tmp/mc.sha256sum); \
    echo "${MC_SHA}  /tmp/${MC_ASSET}" | sha256sum -c - && \
    install -m 0755 /tmp/${MC_ASSET} ${BIN}/mc && \
    rm /tmp/${MC_ASSET} /tmp/mc.sha256sum || exit 1; \
    # rclone
    curl -sSL -o /tmp/rclone.zip \
      "https://github.com/rclone/rclone/releases/download/${RCLONE_VERSION}/rclone-${RCLONE_VERSION}-linux-${ARCH}.zip" && \
    unzip -j /tmp/rclone.zip "rclone-${RCLONE_VERSION}-linux-${ARCH}/rclone" -d ${BIN} && \
    chmod +x ${BIN}/rclone && \
    rm /tmp/rclone.zip; \
    # kubernetes-mcp-server (standalone binary, no npm/node needed)
    curl -sSL -o ${BIN}/kubernetes-mcp-server \
      "https://github.com/containers/kubernetes-mcp-server/releases/download/${K8S_MCP_VERSION}/kubernetes-mcp-server-linux-${ARCH}" && \
    chmod +x ${BIN}/kubernetes-mcp-server

# ---------------------------------------------------------------------------
# Python packages via chroot into rootfs
# ---------------------------------------------------------------------------
COPY requirements.txt ${DNF_INSTALL_ROOT}/tmp/requirements.txt
RUN cp /etc/resolv.conf ${DNF_INSTALL_ROOT}/etc/resolv.conf && \
    chroot ${DNF_INSTALL_ROOT} pip3 install --no-cache-dir --require-hashes -r /tmp/requirements.txt && \
    rm ${DNF_INSTALL_ROOT}/tmp/requirements.txt && \
    rm -f ${DNF_INSTALL_ROOT}/usr/bin/pip ${DNF_INSTALL_ROOT}/usr/bin/pip3 \
          ${DNF_INSTALL_ROOT}/usr/local/bin/pip ${DNF_INSTALL_ROOT}/usr/local/bin/pip3 \
          # ${DNF_INSTALL_ROOT}/usr/bin/ansible-galaxy \
          # ${DNF_INSTALL_ROOT}/usr/local/bin/ansible-galaxy && \
    rm -rf ${DNF_INSTALL_ROOT}/usr/lib/python3.12/site-packages/pip \
           ${DNF_INSTALL_ROOT}/usr/share/python3-wheels \
           ${DNF_INSTALL_ROOT}/usr/share/cracklib

# ---------------------------------------------------------------------------
# User setup in rootfs
# ---------------------------------------------------------------------------
RUN echo "igou:x:1000:1000::/home/igou:/bin/bash" >> ${DNF_INSTALL_ROOT}/etc/passwd && \
    echo "igou:x:1000:" >> ${DNF_INSTALL_ROOT}/etc/group && \
    mkdir -p ${DNF_INSTALL_ROOT}/home/igou && \
    chown 1000:1000 ${DNF_INSTALL_ROOT}/home/igou

# Workspace directory
RUN mkdir -p ${DNF_INSTALL_ROOT}/workspace && \
    chown 1000:1000 ${DNF_INSTALL_ROOT}/workspace

# ---------------------------------------------------------------------------
# Claude Code build stage — CLI and seccomp filter
# ---------------------------------------------------------------------------
FROM ${UBI_IMAGE} AS claude-build

RUN dnf install -y nodejs-npm gnupg2

RUN groupadd -g 1000 igou 2>/dev/null || true && \
    useradd -m -u 1000 -g 1000 igou 2>/dev/null || true

# Claude Code — verify the signed release checksum manifest with the pinned
# Anthropic signing-key fingerprint, as in igou-devenv.
# renovate: datasource=github-releases depName=anthropics/claude-code
ARG CLAUDE_CODE_VERSION="v2.1.288"
ARG CLAUDE_CODE_PGP_FPR="31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE"
ARG CLAUDE_CODE_PGP_URL="https://downloads.claude.ai/keys/claude-code.asc"
USER 1000
RUN set -eux; \
    ARCH_RAW=$(uname -m); \
    case "$ARCH_RAW" in \
      x86_64)  ARCH="x64" ;; \
      aarch64) ARCH="arm64" ;; \
      *) echo "Unsupported arch: $ARCH_RAW" >&2; exit 1 ;; \
    esac; \
    TARBALL="claude-linux-${ARCH}.tar.gz"; \
    BASE="https://github.com/anthropics/claude-code/releases/download/${CLAUDE_CODE_VERSION}"; \
    WORK=$(mktemp -d); \
    export GNUPGHOME="$WORK/gnupg"; \
    mkdir -p -m 0700 "$GNUPGHOME"; \
    cd "$WORK"; \
    curl -fsSL -o key.asc "${CLAUDE_CODE_PGP_URL}"; \
    gpg --batch --import key.asc; \
    # Reject any key whose fingerprint doesn't match the pinned anchor.
    gpg --list-keys --with-colons --with-fingerprint \
      | awk -F: '$1=="fpr"{print $10}' \
      | grep -qFx "${CLAUDE_CODE_PGP_FPR}"; \
    curl -fsSL -o "$TARBALL" "${BASE}/${TARBALL}"; \
    curl -fsSL -o SHASUMS256.txt "${BASE}/SHASUMS256.txt"; \
    curl -fsSL -o SHASUMS256.txt.sig "${BASE}/SHASUMS256.txt.sig"; \
    # Require not just a valid signature, but one from our pinned key.
    # gpg's --status-fd emits "VALIDSIG <fpr>" only on a good signature from <fpr>.
    gpg --batch --status-fd 1 --verify SHASUMS256.txt.sig SHASUMS256.txt 2>/dev/null \
      | grep -qF "VALIDSIG ${CLAUDE_CODE_PGP_FPR}"; \
    grep " ${TARBALL}\$" SHASUMS256.txt | sha256sum -c -; \
    mkdir -p "$HOME/.local/share/claude" "$HOME/.local/bin"; \
    tar -xzf "$TARBALL" -C "$HOME/.local/share/claude"; \
    ln -sfn "$HOME/.local/share/claude/claude" "$HOME/.local/bin/claude"; \
    cd / && rm -rf "$WORK"; \
    "$HOME/.local/bin/claude" --version
USER root

# Seccomp filter for Claude Code sandbox (blocks unix domain sockets).
# Version pinned in package.json, managed by Renovate's native npm manager.
# v0.0.47+ bakes the BPF program into apply-seccomp; no separate .bpf file.
COPY package.json package-lock.json /tmp/sandbox/
RUN set -eux; \
    UARCH=$(uname -m); \
    case "$UARCH" in x86_64) SECCOMP_ARCH=x64;; aarch64) SECCOMP_ARCH=arm64;; *) SECCOMP_ARCH=$UARCH;; esac; \
    SANDBOX_DIR=/opt/claude-sandbox; \
    mkdir -p "$SANDBOX_DIR"; \
    cd /tmp/sandbox && npm ci --ignore-scripts && \
    cp "node_modules/@anthropic-ai/sandbox-runtime/vendor/seccomp/${SECCOMP_ARCH}/apply-seccomp" "$SANDBOX_DIR/" && \
    chmod +x "$SANDBOX_DIR/apply-seccomp"

# ---------------------------------------------------------------------------
# Final minimal image
# ---------------------------------------------------------------------------
FROM scratch

ARG DNF_INSTALL_ROOT="/mnt/rootfs"
COPY --from=build ${DNF_INSTALL_ROOT}/ /

ENV HOME=/home/igou
ENV PATH="/home/igou/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV PYTHONNOUSERSITE=1
ENV PYTHONPATH="/usr/local/lib64/python3.12/site-packages:/usr/local/lib/python3.12/site-packages"
ENV PIP_NO_INPUT=1

# Claude Code binary and dependencies
COPY --from=claude-build /home/igou/.local/bin /home/igou/.local/bin
COPY --from=claude-build /home/igou/.local/share /home/igou/.local/share
RUN chmod 555 /home/igou/.local/bin

# Seccomp filter
COPY --from=claude-build /opt/claude-sandbox/ /usr/local/lib/claude-sandbox/

# Claude home directory
RUN mkdir -p /home/igou/.claude && \
    chown -R 1000:1000 /home/igou/.claude /home/igou/.local

# Baked configs: MCP servers, sandbox settings, global CLAUDE.md
RUN mkdir -p /etc/claude
COPY claude.json /etc/claude/claude.json
COPY settings.json /etc/claude/settings.json
COPY CLAUDE.md /etc/claude/CLAUDE.md

# Config merge script (used by entrypoint to merge baked + user configs)
RUN mkdir -p /usr/local/lib/claude-container
COPY merge-config.py /usr/local/lib/claude-container/merge-config.py

# Entrypoint
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace
USER 1000
ENTRYPOINT ["entrypoint.sh"]
CMD ["claude"]
