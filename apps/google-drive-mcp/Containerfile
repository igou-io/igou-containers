FROM registry.access.redhat.com/ubi10/nodejs-22-minimal:latest@sha256:62208c78a3567cc4c35f49dd3b0bc8bf27604e39afe409ea510b327f03c78f29 AS dependencies
USER 0
WORKDIR /opt/gdrive-mcp
COPY package.json package-lock.json ./
COPY patch-upstream.mjs ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && \
    node patch-upstream.mjs && \
    npm cache clean --force

FROM registry.access.redhat.com/ubi10/nodejs-22-minimal:latest@sha256:62208c78a3567cc4c35f49dd3b0bc8bf27604e39afe409ea510b327f03c78f29
ENV NODE_ENV=production \
    XDG_CONFIG_HOME=/tmp/gdrive-mcp \
    XDG_CACHE_HOME=/tmp/gdrive-mcp/cache
WORKDIR /opt/gdrive-mcp
COPY --from=dependencies /opt/gdrive-mcp /opt/gdrive-mcp
USER 1001
EXPOSE 3100
ENTRYPOINT ["node", "/opt/gdrive-mcp/node_modules/@piotr-agier/google-drive-mcp/dist/index.js"]
CMD ["start", "--transport", "http", "--host", "0.0.0.0", "--port", "3100"]
