FROM registry.access.redhat.com/ubi10/nodejs-22-minimal:latest@sha256:6f9361c4f61e2c8127e138637adbf96cc49f5979be6e2dfb9d58f73835ba4860 AS dependencies
USER 0
WORKDIR /opt/gdrive-mcp
COPY package.json package-lock.json ./
COPY patch-upstream.mjs ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && \
    node patch-upstream.mjs && \
    npm cache clean --force

FROM registry.access.redhat.com/ubi10/nodejs-22-minimal:latest@sha256:6f9361c4f61e2c8127e138637adbf96cc49f5979be6e2dfb9d58f73835ba4860
ENV NODE_ENV=production \
    XDG_CONFIG_HOME=/tmp/gdrive-mcp \
    XDG_CACHE_HOME=/tmp/gdrive-mcp/cache
WORKDIR /opt/gdrive-mcp
COPY --from=dependencies /opt/gdrive-mcp /opt/gdrive-mcp
USER 1001
EXPOSE 3100
ENTRYPOINT ["node", "/opt/gdrive-mcp/node_modules/@piotr-agier/google-drive-mcp/dist/index.js"]
CMD ["start", "--transport", "http", "--host", "0.0.0.0", "--port", "3100"]
