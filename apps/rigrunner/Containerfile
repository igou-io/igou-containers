# Rig Runner - single-file canvas platformer, served as static content.
# nginx-unprivileged listens on 8080 and runs as a non-root user out of the
# box, which satisfies the arbitrary-UID convention without an s2i toolchain
# (there is no UBI static-file image that avoids one).
FROM docker.io/nginxinc/nginx-unprivileged:stable-alpine@sha256:9b87ad3dd9f431c733f19dfb278c7eb3dba9dca381942c79818bb42f1a566a83

COPY index.html /usr/share/nginx/html/index.html
